# ---------------------------------------------------------------------------
# Semua variabel OPSIONAL. Tanpa satu pun, aplikasi tetap jalan dalam "mode
# demo": peta, titik api (NASA FIRMS), gempa (BMKG), cuaca, NDVI, dan analisis
# tutupan lahan (Esri) memakai sumber data publik tanpa kredensial. Login &
# penyimpanan data pribadi (lahan, skenario) baru aktif setelah Cognito dan DynamoDB diisi.
# ---------------------------------------------------------------------------

# Login: Amazon Cognito (User Pool + app client tanpa secret). Lihat docs/deployment.md bagian 2.
# Dipakai browser (tertanam saat build, jadi harus ada saat `docker build`/`next build`):
NEXT_PUBLIC_COGNITO_REGION=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Dipakai server untuk memverifikasi token login:
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Penyimpanan data pengguna: satu tabel DynamoDB (kunci pk/sk). Kredensial AWS dari role IAM instance
# (jangan menulis access key di sini). AWS_REGION default ap-southeast-2.
DYNAMODB_TABLE=
AWS_REGION=

# Hanya untuk pengembangan/uji lokal dengan emulator (Moto): jangan diisi di produksi.
# DYNAMODB_ENDPOINT=http://127.0.0.1:5555
# COGNITO_ENDPOINT=http://127.0.0.1:5555
# COGNITO_JWKS_URL=http://127.0.0.1:5555/<pool-id>/.well-known/jwks.json
# NEXT_PUBLIC_COGNITO_ENDPOINT=http://127.0.0.1:5555

# URL services/geo (FastAPI + Google Earth Engine, dataset ESA WorldCover).
# Kosong -> analisis tutupan lahan memakai Esri/Impact Observatory 10m Land Cover.
GEO_SERVICE_URL=
# Kalau services/geo memakai GEO_API_KEY, isi nilai yang sama di sini (dikirim sebagai header X-API-Key).
GEO_SERVICE_API_KEY=

# Satelit sumber titik api NASA FIRMS: noaa20 (default) | noaa21 | snpp (file NASA kosong per 2026-11-10)
FIRMS_SATELLITE=

# API key Anthropic untuk asisten LandAI. Kosong -> LandAI menjawab dengan
# mode berbasis aturan (tetap memakai data asli FIRMS/BMKG/Open-Meteo).
# Dengan login (Cognito) aktif, mode ini hanya untuk pengguna yang sudah login.
ANTHROPIC_API_KEY=
# Model Claude untuk LandAI (default claude-opus-5-5). Contoh hemat biaya: claude-sonnet-5-5, claude-haiku-4-5.
ANTHROPIC_MODEL=

# Redis bersama (Upstash) untuk cache & rate limit lintas instance. Opsional; kosong -> in-memory per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Rahasia untuk /api/cron/warm (pemanasan cache terjadwal). Kosong -> route menolak semua request.
CRON_SECRET=

# --- Penyetelan lanjutan (jarang perlu diubah) ---
# Batas waktu percobaan koneksi Node ke tiap alamat (ms). Server yang jauh dari AS
# (termasuk Indonesia) butuh > 250 ms bawaan Node supaya fetch ke NASA tidak gagal.
NET_ATTEMPT_TIMEOUT_MS=5000
# Set 1 untuk mematikan pemanasan cache saat server start (mis. di lingkungan test).
DISABLE_CACHE_WARMUP=
